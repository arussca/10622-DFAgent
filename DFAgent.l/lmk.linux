LDLIBS += ${XPA_LIBS} ${FITSIO_LIBS} ${WCS_LIBS} ${GSL_LIBS} $(TAO_LIBS) $(DSL_LIBS) -lsla -lDDPKF -lcfitsio -lRF -lDPKF -lParserLibrary -lConfigFileMgr -lDPhysicalQuantity   -lCatalog -lFilters -lDAF -lDPKF_IO -lPhysicalQuantity  -lDataDisplay -lTask $(SSL_LIBS) $(DSL_DEV_LIBS) -lPeriodicTask

LDLIBS += ${JSON_LIBS} -ljsoncpp

